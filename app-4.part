function addBulk(){const deckId=$('addDeck').value,lines=$('bulkInput').value.split(/\n+/).map(x=>x.trim()).filter(Boolean);let added=0,bad=0;for(const line of lines){const p=line.indexOf('|');if(p<1){bad++;continue;}const front=line.slice(0,p).trim(),back=line.slice(p+1).trim();if(!front||!back){bad++;continue;}if(deckCards(deckId).some(c=>normalize(c.front)===normalize(front)&&normalize(c.back)===normalize(back)))continue;state.cards[deckId].push({id:`local-${deckId}-${Date.now()}-${Math.random().toString(36).slice(2)}`,remoteId:null,front,back,created:Date.now()+Math.random(),source:'local',schedules:{recognition:freshSchedule(Date.now()),production:freshSchedule(Date.now())}});added++;}$('bulkMsg').textContent=`${added} frase(s) adicionada(s)`+(bad?` · ${bad} inválida(s)`:'');if(added){$('bulkInput').value='';toast(`${added} frase(s) adicionada(s).`);}render();}
async function syncDeck(deckId){
  const res=await fetch(`./decks/${DECKS[deckId].file}?v=${Date.now()}`,{cache:'no-store'});if(!res.ok)throw new Error();const remote=await res.json();if(!remote||!Array.isArray(remote.cards))throw new Error();const local=state.cards[deckId],now=Date.now();let added=0,matched=0;
  for(const rc of remote.cards){if(!rc.id||!rc.front||!rc.back)continue;let lc=local.find(c=>c.remoteId===rc.id)||local.find(c=>normalize(c.front)===normalize(rc.front)&&normalize(c.back)===normalize(rc.back));if(lc){lc.remoteId=rc.id;lc.front=rc.front;lc.back=rc.back;matched++;}else{const due=now+(Number(rc.initial_due_days)||0)*DAY;local.push({id:`remote-${deckId}-${rc.id}`,remoteId:rc.id,front:rc.front,back:rc.back,created:now+local.length,source:'remote',schedules:{recognition:freshSchedule(due),production:freshSchedule(due)}});added++;}}return{added,matched};
}
async function syncAll(showMessage=true){try{const results={};for(const id of Object.keys(DECKS))results[id]=await syncDeck(id);save();render();if(showMessage){const n=Object.values(results).reduce((s,x)=>s+x.added,0);$('syncMsg').textContent=n?`${n} nova(s) frase(s) recebida(s).`:'Decks já estavam atualizados.';toast(n?`${n} nova(s) frase(s) sincronizada(s).`:'Tudo sincronizado.');}return true;}catch(e){if(showMessage)$('syncMsg').textContent='Não foi possível sincronizar agora. O app continuará offline.';return false;}}
function exportBackup(){const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`recall-v4-backup-${dayKey()}.json`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);}
function importBackup(file){const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(String(r.result));if(!x||x.version!==4||!x.cards)throw new Error();state=x;save();currentItem=null;flipped=false;render();toast('Backup restaurado.');}catch(e){toast('Backup inválido.');}};r.readAsText(file);}
let toastTimer;function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2300);}

$('flashcard').addEventListener('click',()=>{flipped=!flipped;renderReview();maybeAutoPlayCurrent();});
$('audioNormal').addEventListener('click',()=>speak());$('audioSlow').addEventListener('click',()=>speak(.72));
document.querySelectorAll('.rate').forEach(b=>b.addEventListener('click',()=>rateCard(b.dataset.rating)));
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view)));
$('syncBtn').addEventListener('click',()=>syncAll(true));$('settingsBtn').addEventListener('click',()=>showView('settings'));$('bulkAdd').addEventListener('click',addBulk);$('exportBtn').addEventListener('click',exportBackup);$('importFile').addEventListener('change',e=>{const f=e.target.files?.[0];if(f)importBackup(f);e.target.value='';});$('search').addEventListener('input',renderLibrary);$('libraryDeck').addEventListener('change',renderLibrary);
$('settingsDeck').addEventListener('change',renderSettings);$('studyMode').addEventListener('change',()=>{const id=$('settingsDeck').value;state.settings.modeByDeck[id]=$('studyMode').value;if(id===selectedDeck()){currentItem=null;sessionInitial=dueNow(id).length;sessionDone=0;}save();renderSettings();renderDecks();});
$('voiceSelect').addEventListener('change',()=>{const id=$('settingsDeck').value;state.settings.voiceByDeck[id]=$('voiceSelect').value;save();});$('settingsSpeed').addEventListener('change',()=>{const id=$('settingsDeck').value;state.settings.speedByDeck[id]=Number($('settingsSpeed').value)||1;if(id===selectedDeck())$('speed').value=String(state.settings.speedByDeck[id]);save();});$('speed').addEventListener('change',()=>{state.settings.speedByDeck[selectedDeck()]=Number($('speed').value)||1;save();});$('autoPlay').addEventListener('change',()=>{state.settings.autoPlay=$('autoPlay').checked;save();});$('testVoice').addEventListener('click',()=>{const id=$('settingsDeck').value,sample=id==='de'?'Hallo! Wie geht es dir?':'Hello! How are you today?';speakText(sample,id,Number($('settingsSpeed').value)||1);});

if('serviceWorker'in navigator)navigator.serviceWorker.register('./sw.js').catch(()=>{});
window.addEventListener('online',()=>syncAll(false));
sessionInitial=dueNow().length;render();syncAll(false).then(()=>{sessionInitial=dueNow().length;render();});
})();
